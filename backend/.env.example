APP_NAME=Pingura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8123

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@pingura.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin dashboard / patient report frontend origins ---
# Only origins that need cookie-authenticated (Sanctum) access belong in
# SANCTUM_STATEFUL_DOMAINS -- that's the admin dashboard only. The patient
# report app is public and token-authenticated, so keep it OUT of this list
# or its requests get forced through CSRF/session middleware and fail.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# --- Meta WhatsApp Cloud API ---
# See README.md for how to obtain these from the Meta developer console.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pingura-verify
WHATSAPP_API_VERSION=v21.0
