# Copy this to `.env` DIRECTLY ON THE SERVER via SSH (never commit real
# secrets, and never let the deploy workflow overwrite this file — it's
# excluded from the rsync on purpose). Fill in every placeholder below.

APP_NAME=Pingura
APP_ENV=production
APP_KEY=                      # generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.care.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- cPanel MySQL Databases (create via cPanel > MySQL Database Wizard) ---
# cPanel prefixes both the DB name and username with your cPanel username,
# e.g. cpaneluser_pingura / cpaneluser_pinguser
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_pingura
DB_USERNAME=cpaneluser_pinguser
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot so the cookie is valid across care.yourdomain.com AND
# api.care.yourdomain.com AND report.care.yourdomain.com (all subdomains of
# care.yourdomain.com). MUST match your real domain or dashboard login breaks.
SESSION_DOMAIN=.care.yourdomain.com
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend origins ---
# Only the admin dashboard needs cookie-authenticated (Sanctum) access.
# The patient report app is public/token-based -- keep it OUT of
# SANCTUM_STATEFUL_DOMAINS or its requests will be forced through CSRF/session
# middleware and fail (this bit us in local dev too -- see project history).
SANCTUM_STATEFUL_DOMAINS=care.yourdomain.com
FRONTEND_URLS=https://care.yourdomain.com,https://report.care.yourdomain.com

# --- Meta WhatsApp Cloud API (filled in during the WhatsApp setup phase) ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
